{
  "rules": {
    ".read": false,
    ".write": false,
    "gc": {
      "$day": {
        ".read": "auth != null && data.child('t').val() < now - 172800000",
        ".write": "auth != null && !newData.exists() && data.child('t').val() < now - 172800000",
        "t": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() <= now && newData.val() > now - 60000"
        },
        "c": {
          "$code": {
            ".write": "auth != null && (newData.exists() ? root.child('rooms').child($code).child('host').val() === auth.uid : data.parent().parent().child('t').val() < now - 172800000)",
            ".validate": "newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('host').val() === auth.uid || (!data.exists() && newData.child('host').val() === auth.uid) || (!newData.exists() && (data.child('last').exists() ? data.child('last').val() < now - 86400000 : data.child('created').val() < now - 86400000)))",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        "host": {
          ".write": "auth != null && newData.val() === auth.uid && data.parent().child('players').child(auth.uid).child('on').val() === true && data.parent().child('players').child(data.val()).child('on').val() !== true"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
            },
            "on": {
              ".validate": "newData.isBoolean()"
            },
            "joined": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "ans": {
          "$q": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid && !data.exists() && data.parent().parent().parent().child('state').val() === 'play' && 'q' + data.parent().parent().parent().child('qi').val() === $q && data.parent().parent().parent().child('phase').val() === 'q'",
              ".validate": "newData.hasChildren(['ok', 'ms']) && newData.child('ok').isBoolean() && newData.child('ms').isNumber()",
              "a": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "to": {
                ".validate": "newData.isBoolean()"
              },
              "ok": {
                ".validate": true
              },
              "ms": {
                ".validate": true
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
